# Firebase Admin SDK — paste the full JSON from a downloaded service
# account key as a single-line string (Project Settings > Service
# accounts > Generate new private key in the Firebase console).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}

# PayFast sandbox credentials — from https://sandbox.payfast.co.za
# after creating a free sandbox account. Use PayFast's default
# sandbox merchant_id/merchant_key while testing if you don't want
# to create your own sandbox merchant profile yet.
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=your-sandbox-passphrase

# "sandbox" or "live"
PAYFAST_MODE=sandbox

# The deployed site URL, no trailing slash (Vercel gives you this,
# e.g. https://urban-threads-store.vercel.app)
APP_URL=https://your-deployment.vercel.app
